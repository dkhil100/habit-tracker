{# templates/components/navbar.html.twig #}
<nav class="bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex items-center">
                <a href="{{ path('app_dashboard') }}" class="text-xl font-bold text-indigo-600">HabitTracker</a>
            </div>
            <div class="flex items-center space-x-4">
                {% if app.user %}
                    <span class="text-sm font-medium text-gray-700">Hello, {{ app.user.username }}</span>
                    <a href="{{ path('app_logout') }}" class="text-sm font-medium text-red-600 hover:text-red-800">Logout</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>